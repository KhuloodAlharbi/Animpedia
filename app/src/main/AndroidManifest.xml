<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Animapedia">

        <!-- LoginActivity is now the launcher -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Main Activities -->
        <activity android:name=".HomeActivity" android:exported="false" >


        </activity>
        <activity android:name=".ChatbotActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />

        <!-- Store & Cart -->
        <activity android:name=".StoreActivity" android:exported="false" />
        <activity android:name=".ProductDetailsActivity" android:exported="false" />
        <activity android:name=".CartActivity" android:exported="false" />
        <activity android:name=".BillingActivity" android:exported="false" />

        <!-- Favorites -->
        <activity android:name=".FavoritesActivity" android:exported="false" />

        <!-- Animal Categories -->
        <activity android:name=".MammalsActivity" android:exported="false" />
        <activity android:name=".BirdsActivity" android:exported="false" />
        <activity android:name=".ReptilesActivity" android:exported="false" />
        <activity android:name=".Fish" android:exported="false" />
        <activity android:name=".InsectsActivity" android:exported="false" />
        <activity android:name=".Invertebrates" android:exported="false" />
        <activity android:name=".Amphibians" android:exported="false" />

        <!-- Animal Details -->
        <activity android:name=".AnimalDetailsActivity" android:exported="false" />

    </application>

</manifest>
